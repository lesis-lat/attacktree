# Dependencies
node_modules/

# Build output (vite build -> dist/) and caches
dist/
dist-ssr/
.vite/
*.tsbuildinfo
*.local

# Tests and browser checks
coverage/
test-results/
playwright-report/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files: never commit secrets
.env
.env.*
!.env.example

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local Claude Code settings (shared settings in .claude/settings.json stay tracked)
.claude/settings.local.json

# Threat models are client material: they never go in the repo. The only tree that
# ships is the bundled example in src/model/examples.ts. This keeps out trees, YAML
# sources and exported images saved at the top level or in a local folder.
*.attacktree.yaml
/*.yaml
/*.yml
/*.svg
/*.png
/*.dot
scratch/
trees/
models/
threat-models/
